# .env.brandflocks — template voor Brandflocks op Antagonist (tests/training).
#
#   cp .env.brandflocks.example .env.brandflocks
#   # vul waarden in (eigen DB, FTP-pad, URL — géén staging/productie-sleutels)
#   ./scripts/check-env-isolation.sh brandflocks
#   ./scripts/deploy-ftp.sh brandflocks
#
# Zelfde fysieke server als staging mag; DB, FTP-user/pad, URL, tokens en webhooks
# moeten wijken van zowel .env (productie) als .env.staging.

CE_ENV=brandflocks

# ── FTP [MOET VERSCHILLEN van productie én staging] ─────────────────────────
FTP_HOST=ftp.igisnext.com
FTP_PORT=21
FTP_USER=erik-brandflocks@brandflocks.jouwdomein.nl
FTP_PASSWORD=
FTP_PROTOCOL=ftp
FTP_REMOTE_PATH=/

# ── Database [MOET VERSCHILLEN] ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=igisnext_cf_brandflocks
DB_USER=igisnext_cf-bf
DB_PASS=""

# ── URL's [MOET VERSCHILLEN] ────────────────────────────────────────────────
CE_PUBLIC_BASE_URL=https://brandflocks.jouwdomein.nl
CE_ALLOWED_ORIGINS=https://brandflocks.jouwdomein.nl,http://localhost:5173

CE_SUPPORT_EMAIL=
CE_REVIEW_EMAIL=
CE_PILOT_ALERT_EMAILS=
CE_MAIL_FROM=Brandflocks <noreply@brandflocks.jouwdomein.nl>

# ── Tokens [MOET VERSCHILLEN] ───────────────────────────────────────────────
CE_RESET_TOKEN=
CE_CREDENTIAL_KEY=

# ── n8n [MOET VERSCHILLEN] ──────────────────────────────────────────────────
N8N_API_URL=https://erikjihaa.app.n8n.cloud
N8N_API_KEY=
N8N_WEBHOOK_SUFFIX=-brandflocks
N8N_CE_FOLDER_ID=
N8N_MYSQL_CREDENTIAL_ID=
N8N_MYSQL_CREDENTIAL_NAME=Content Engine [brandflocks]
N8N_CE01_WEBHOOK_URL=
N8N_CE01B_WEBHOOK_URL=
N8N_CE02_WEBHOOK_URL=
N8N_CE03_WEBHOOK_URL=
N8N_CE04_WEBHOOK_URL=
N8N_CE04_HUMAN_WEBHOOK_URL=
N8N_CE07_WEBHOOK_URL=
N8N_CE_CAMPAIGN_PLAN_WEBHOOK_URL=
N8N_CE_LLM_VISIBILITY_WEBHOOK_URL=

# ── WordPress [MOET VERSCHILLEN — leeg = geen live publish] ─────────────────
WORDPRESS_SITE_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WORDPRESS_AUTHOR_ID=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_GEMINI_API_KEY=
CE_SUPPORT_CHAT_BUDGET_EUR=1
APIFY_API_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=

CE_BACKUP_DIR=
