# .env.staging — template voor de staging-omgeving.
#
#   cp .env.staging.example .env.staging
#   # vul de waarden in
#   ./scripts/check-env-isolation.sh staging
#   ./scripts/deploy-ftp.sh staging
#
# De regels gemarkeerd met [MOET VERSCHILLEN] worden door
# scripts/check-env-isolation.sh vergeleken met .env (productie). Zijn ze gelijk, dan
# weigert het script te deployen. Reden: zonder echt gescheiden database en FTP-pad is
# staging geen tweede omgeving maar een tweede weg naar productie.

# Zet de omgevingsbanner aan, tagt elke event_log-regel als staging en zet de guard op
# destructieve endpoints uit (die is er alleen voor productie).
CE_ENV=staging

# ── FTP [MOET VERSCHILLEN] ───────────────────────────────────────────────────
# Productie gebruikt FTP_REMOTE_PATH=/ met een user die in de CE-root staat. Een
# staging-deploy met diezelfde user overschrijft dus de live site, ook als het pad
# klopt maar je een typefout maakt. Maak in cPanel → FTP Accounts een aparte gebruiker
# met een eigen directory, en gebruik die hier.
FTP_HOST=ftp.igisnext.com
FTP_PORT=21
FTP_USER=erik-staging@staging.igisnext.com
FTP_PASSWORD=
FTP_PROTOCOL=ftp
# Staging-subaccounts op cPanel gebruiken vaak plain FTP (poort 21), geen FTPS.
# Productie CE-subaccount: meestal ftps.
FTP_REMOTE_PATH=/
# Test de verbinding vóór de eerste deploy: ./scripts/deploy-ftp-probe.sh

# ── Database [MOET VERSCHILLEN] ──────────────────────────────────────────────
# Aparte database én aparte gebruiker. Alleen een andere naam met dezelfde
# DB_USER is niet genoeg: die gebruiker houdt rechten op de productiedatabase, dus
# één fout in een migratie raakt alsnog live data.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=igisnext_cf_staging
DB_USER=igisnext_cf-stg
DB_PASS=""

# ── URL's [MOET VERSCHILLEN] ─────────────────────────────────────────────────
# Staat hier de productie-URL, dan sturen smoke-test, run-migration en backup-db hun
# verzoeken naar productie terwijl ze "staging" rapporteren.
CE_PUBLIC_BASE_URL=https://staging.igisnext.com
CE_ALLOWED_ORIGINS=https://staging.igisnext.com,http://localhost:5173
# ── E-mail ───────────────────────────────────────────────────────────────────
# Productie gebruikt support@igisnext.com — staging mag afwijken (eigen inbox/label).
#
# CE_SUPPORT_EMAIL  → event_log-foutmeldingen + Support-pagina
# CE_REVIEW_EMAIL   → standaard reviewer human-review
# CE_MAIL_FROM      → afzender PHP mail()
CE_SUPPORT_EMAIL=
# IMAP voor platform-import (Settings → Importeer support-mails)
# CE_SUPPORT_IMAP_EMAIL=   → default: CE_SUPPORT_EMAIL
# CE_SUPPORT_IMAP_HOST=    → optioneel; anders auto-detect via mailbox-helper
CE_SUPPORT_IMAP_PASSWORD=
CE_REVIEW_EMAIL=
# Pilot A3: Negeer bij tegenkracht/regelbreuk — comma-separated (Erik + Rogier)
CE_PILOT_ALERT_EMAILS=
CE_MAIL_FROM=Content Engine STAGING <noreply@staging.igisnext.com>

# ── Tokens [MOET VERSCHILLEN] ────────────────────────────────────────────────
# Eén gelekt reset-token mag niet beide omgevingen openen.
CE_RESET_TOKEN=
# Versleutelt bron-credentials. Een eigen key betekent dat een staging-dump geen
# productie-credentials kán ontsleutelen — dat is het punt van de scheiding.
CE_CREDENTIAL_KEY=

# ── n8n [MOET VERSCHILLEN] ───────────────────────────────────────────────────
# Zelfde n8n-instance mag, maar gebruik andere webhook-paden zodat staging nooit
# de productie-pipeline triggert. Stel N8N_WEBHOOK_SUFFIX in en push workflows:
#   ./scripts/setup-staging-n8n.sh
# Dat maakt workflows met naam "[staging]" en paden als ce01-theme-director-staging.
N8N_API_URL=https://erikjihaa.app.n8n.cloud
N8N_API_KEY=
N8N_WEBHOOK_SUFFIX=-staging
# Optioneel: aparte map in n8n UI voor DEV-workflows (anders blijven ze in de root-map)
N8N_CE_FOLDER_ID=
# MySQL-credential in n8n voor staging-DB (niet de productie-"Content Engine"-credential)
N8N_MYSQL_CREDENTIAL_ID=
N8N_MYSQL_CREDENTIAL_NAME=Content Engine [staging]
N8N_CE01_WEBHOOK_URL=
N8N_CE01B_WEBHOOK_URL=
N8N_CE02_WEBHOOK_URL=
N8N_CE03_WEBHOOK_URL=
N8N_CE04_WEBHOOK_URL=
N8N_CE04_HUMAN_WEBHOOK_URL=
N8N_CE07_WEBHOOK_URL=
N8N_CE_CAMPAIGN_PLAN_WEBHOOK_URL=
N8N_CE_LLM_VISIBILITY_WEBHOOK_URL=

# ── WordPress [MOET VERSCHILLEN] ─────────────────────────────────────────────
# Staging publiceert niet naar productie-WP. Leeglaten = publish faalt netjes.
# Zelfde veldnamen als .env — zie .env.example voor uitleg.
WORDPRESS_SITE_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WORDPRESS_AUTHOR_ID=1

# ── OAuth ────────────────────────────────────────────────────────────────────
# Dezelfde client-id's mogen, maar de redirect-URI's van staging moeten apart
# geregistreerd worden bij Google en LinkedIn, anders faalt de callback:
#   https://staging.igisnext.com/api/sources/analytics/oauth/callback
#   https://staging.igisnext.com/api/account/linkedin/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Betaalde API's ───────────────────────────────────────────────────────────
# Dezelfde keys werken, maar elke staging-run kost echt geld. Zet Apify leeg tenzij
# je scrapers test; één LinkedIn-run is de duurste losse actie in de app.
ANTHROPIC_API_KEY=
# HBA-laag — model per functie (leeg = HBA_ANTHROPIC_MODEL, anders claude-sonnet-4-6)
# HBA_MODEL_CAMPAGNE_PRODUCT_EXTRACT=
# HBA_MODEL_CAMPAGNE_PLAN_CHECK=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_GEMINI_API_KEY=
CE_SUPPORT_CHAT_BUDGET_EUR=1
APIFY_API_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=

# Staging heeft geen eigen backups nodig — de inhoud is een demo-tenant die
# sync-staging-from-production.sh opnieuw kan aanmaken.
CE_BACKUP_DIR=
