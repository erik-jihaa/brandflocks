# Omgeving — local | staging | production | brandflocks
# Bepaalt de omgevingsbanner in de app, de guard op destructieve endpoints
# (reset-content, delete-client) en de tag op elke event_log-regel.
# Alleen `production` is live (destructieve confirm). Andere slugs tonen de banner.
# Per omgeving een eigen bestand: .env (lokaal), .env.staging, .env.brandflocks.
#   ./scripts/deploy-ftp.sh staging     -> leest .env.staging
#   ./scripts/deploy-ftp.sh production  -> leest .env.production, vraagt bevestiging
CE_ENV=production

# Productnaam (UI, mails, browser-tab). Override per bureau (whitelabel).
CE_PRODUCT_NAME=Brandflocks
# CE_STAGING_LABEL=Brandflocks staging
# CE_PLATFORM_LABEL=Brandflocks platform
# CE_DOCS_URL=https://brandflocks.nl

# n8n
N8N_API_URL=https://erikjihaa.app.n8n.cloud
N8N_API_KEY=plak-hier-je-n8n-api-key
# Content Engine workflows map (n8n project folder)
N8N_CE_FOLDER_ID=HAZb85LfOHAqJYDn

# FTP — ce.igisnext.com (subdomein Content Engine)
# cPanel/igisnext — twee gangbare modi:
#
# A) CE sub-account (direct in CE-root, meestal FTPS poort 21, géén SFTP 22):
# FTP_USER=erik-ce@ce.igisnext.com
# FTP_PROTOCOL=ftps
# FTP_PORT=21
# FTP_REMOTE_PATH=/
#
# B) Hoofdaccount SFTP (FileZilla studio, poort 22) — pad uit cPanel → Subdomains:
# FTP_USER=erik@igisnext.com
# FTP_PROTOCOL=sftp
# FTP_PORT=22
# FTP_REMOTE_PATH=../ce.igisnext.com
#
# Test: ./scripts/deploy-ftp-probe.sh
FTP_HOST=ftp.igisnext.com
FTP_PORT=21
FTP_USER=erik-ce@ce.igisnext.com
FTP_PASSWORD=plak-hier-je-ftp-wachtwoord
FTP_PROTOCOL=ftps
# FTP root = account home (cPanel server path is NOT the FTP path)
FTP_REMOTE_PATH=/

# FTP — igisnext.com hoofdsite (theme / WP-setup via Cursor_iGiSNext_frontend)
# Credentials staan in ../Cursor_iGiSNext_frontend/.env.prod — niet hier dupliceren.
# FTP_HOST=ftp.igisnext.com
# FTP_PORT=21
# FTP_USER=erik@igisnext.com
# FTP_PASS=plak-hier-je-ftp-wachtwoord

# MySQL — Content Engine API (web/api/)
# Speciale tekens (# ; { } etc.): zet het wachtwoord tussen dubbele quotes
DB_HOST=localhost
DB_PORT=3306
DB_NAME=content_engine
DB_USER=
DB_PASS=""

# MySQL — CE-blog (ce.igisnext.com/blog), prefix wpce_
# Na fase 1b-scheiding: eigen database + gebruiker, los van DB_* hierboven.
# Runbook: ./scripts/separate-wordpress-database.sh status|dry-run|migrate|patch-wp-config
# WP_DB_NAME=
# WP_DB_USER=
# WP_DB_PASS=

# CE-04 webhook — AI review (ai-review knop)
N8N_CE04_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce04-review
# CE-04.1bis — human submit: approval-mail + review-link
N8N_CE04_HUMAN_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce04-human-review
# CE-01 Theme Director — wekelijks + handmatige webhook
N8N_CE01_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce01-theme-director
# CE-02 Research — getriggerd door CE-01
N8N_CE02_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce02-research
# CE-01b Theme naar Slot — Submit Theme
N8N_CE01B_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce01b-theme-to-slot
# CE-03 Write Article — Fastlane + campagne-posts
N8N_CE03_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce03-write-article
# CE-CampaignPlanner — campagneplanning (Fastlane campagnemodus)
N8N_CE_CAMPAIGN_PLAN_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce-campaign-plan
# CE-07 Performance Rapportage
N8N_CE07_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce07-performance-report

# CE-LLM-Visibility — GEO-vindbaarheid (Report §2b)
# Keys worden via deploy naar ce.local.php gezet; admin-endpoint draait checks in PHP.
# Maandelijkse n8n-cron kan POST /api/admin/llm-visibility-sync aanroepen (X-CE-Reset-Token).
N8N_CE_LLM_VISIBILITY_WEBHOOK_URL=https://erikjihaa.app.n8n.cloud/webhook/ce-llm-visibility
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_GEMINI_API_KEY=
# Optioneel SERPAPI_API_KEY voor de eerste 50 Google-resultaten (serpapi.com). Zonder SerpAPI gebruikt SEO Perplexity web-zoek.
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID alleen nog voor bestaande engines (Google staat sinds jan 2026 geen nieuwe "hele web"-engines toe).
SERPAPI_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# Support-chatbot — onboarding-assistent (POST /api/support-chat)
# Directe Anthropic-call vanuit PHP; spend-cap per tenant (default €5)
ANTHROPIC_API_KEY=
CE_SUPPORT_CHAT_BUDGET_EUR=5
# CE_SUPPORT_CHAT_MODEL=claude-sonnet-4-6

# HBA-laag — model per functie (fallback: HBA_ANTHROPIC_MODEL → claude-sonnet-4-6)
# Zie briefing/cursor-hba-model-allocatie.md. v1: leeg laten = alles op fallback.
# HBA_ANTHROPIC_MODEL=claude-sonnet-4-6
# HBA_MODEL_WIZARD_HINTS=
# HBA_MODEL_ARCHITECTUUR_CHECK=
# HBA_MODEL_BRANCHE_AFLEIDER=
# HBA_MODEL_THEMA_VERDICT=
# HBA_MODEL_ARTICLE_HINT=
# HBA_MODEL_CONTENT_SCORE=
# HBA_MODEL_CAMPAGNE_PRODUCT_EXTRACT=
# HBA_MODEL_CAMPAGNE_PLAN_CHECK=

# ── E-mail ───────────────────────────────────────────────────────────────────
# Officieel support-adres: support@igisnext.com
#
# CE_SUPPORT_EMAIL  → event_log-foutmeldingen (severity=error) + Support-pagina
# CE_REVIEW_EMAIL   → standaard reviewer bij human-review (CE-04)
# CE_MAIL_FROM        → afzender PHP mail() — wachtwoord-reset, review-mails
#
# Vul in .env (productie) en .env.staging (staging) apart in.
CE_SUPPORT_EMAIL=support@igisnext.com
CE_REVIEW_EMAIL=support@igisnext.com
CE_MAIL_FROM=Brandflocks <support@igisnext.com>
# Platform → Settings → Importeer support-mails (IMAP)
# CE_SUPPORT_IMAP_EMAIL=   → default: CE_SUPPORT_EMAIL
# CE_SUPPORT_IMAP_HOST=    → optioneel; anders auto-detect
CE_SUPPORT_IMAP_PASSWORD=

# Publieke URL voor review-links in mail (zelfde domein als SPA — review op /review/:token)
CE_PUBLIC_BASE_URL=https://ce.igisnext.com
# CORS allowlist (komma-gescheiden); reviewpagina deelt dit domein, geen aparte origin nodig
CE_ALLOWED_ORIGINS=https://ce.igisnext.com,http://localhost:5173
# Tijdelijk login uitschakelen (1 = uit; deploy schrijft auth_disabled naar ce.local.php)
CE_AUTH_DISABLED=0

# Campaign E2E (scripts/test-campaign-e2e.sh) — optioneel vaste login i.p.v. reset-token
# CE_E2E_LOGIN_EMAIL=erik@igisnext.com
# CE_E2E_LOGIN_PASSWORD=
# CE_E2E_POST_COUNT=3

# ── WordPress Application Password (platform-fallback) ─────────────────────
# Tenant zonder eigen WP in Account → CE gebruikt deze vier variabelen.
# Per-klant WP: Account → Publiceren (wordpress_site_url, user, app password).
#
# App-wachtwoord: WP → Gebruikers → Profiel → Applicatie-wachtwoorden.
# Speciale tekens (&, ), !, $): wachtwoord tussen dubbele quotes.
# Site-URL = REST-basis, geen /wp-admin.
#
# CE-blog install: scripts/setup-ce-wordpress.sh
# Hoofdsite koppeling: scripts/setup-igisnext-wordpress-ce.sh
#
# curl -s -u 'USER:APP_PASS' 'SITE/wp-json/wp/v2/users/me'

WORDPRESS_SITE_URL=https://ce.igisnext.com/blog
WORDPRESS_USER=content-engine
WORDPRESS_APP_PASSWORD=
WORDPRESS_AUTHOR_ID=1

# Alternatief hoofdsite:
# WORDPRESS_SITE_URL=https://igisnext.com
# WORDPRESS_USER=content-engine
# WORDPRESS_APP_PASSWORD=
# WORDPRESS_AUTHOR_ID=1

# Agenda week-label als phase_key geen nummer bevat — standaard actuele ISO-week (Europe/Amsterdam)
# CE_WEEK_START=26
# CE_TIMEZONE=Europe/Amsterdam

# Trello — bronnen-tab + CE-02 research (https://trello.com/app-key)
TRELLO_API_KEY=
TRELLO_TOKEN=

# Apify — platform-token voor LinkedIn research/scraper (klanten zien dit niet)
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# LinkedIn Scan — linkedin-analyse.igisnext.com (los van CE)
# Deploy: ./scripts/deploy-linkedin-analyse.sh production
# Live test: php linkedin-analyse/scripts/run-live-scan.php growthelements
LINKEDIN_ANALYSE_BASE_URL=https://linkedin-analyse.igisnext.com/linkedin-analyse
LINKEDIN_ANALYSE_APP_EMAIL=erik@igisnext.com
LINKEDIN_ANALYSE_APP_PASSWORD=
LINKEDIN_ANALYSE_EVA_EMAIL=eva@igisnext.com
LINKEDIN_ANALYSE_EVA_APP_PASSWORD=
# Narratief-analyse (Claude Haiku) — gebruikt ANTHROPIC_API_KEY als fallback
LINKEDIN_ANALYSE_AI_SUMMARY_ENABLED=true
# LINKEDIN_ANALYSE_ANTHROPIC_API_KEY=
# LINKEDIN_ANALYSE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LINKEDIN_ANALYSE_NARRATIVE_MAX_COST_USD=0.02
# Wachtwoord-reset — fallback: CE_MAIL_FROM
# LINKEDIN_ANALYSE_MAIL_FROM=LinkedIn Scan <support@igisnext.com>
# FTP — apart subdomein-account (aanbevolen) of hoofdaccount:
# LINKEDIN_ANALYSE_FTP_USER=erik@igisnext.com
# LINKEDIN_ANALYSE_FTP_PROTOCOL=sftp
# LINKEDIN_ANALYSE_FTP_PORT=22
# LINKEDIN_ANALYSE_FTP_REMOTE_PATH=../linkedin-analyse.igisnext.com
LINKEDIN_ANALYSE_FTP_REMOTE_PATH=/
# MySQL — aparte database (niet CE-tenant)
LINKEDIN_ANALYSE_DB_HOST=localhost
LINKEDIN_ANALYSE_DB_NAME=linkedin_analyse
LINKEDIN_ANALYSE_DB_USER=
LINKEDIN_ANALYSE_DB_PASS=

# GA4 + Google Calendar — zelfde OAuth-client en callback:
#   https://ce.igisnext.com/api/sources/analytics/oauth/callback
# Schakel Google Calendar API in voor agenda-bronnen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn — Publiceer-extra "LinkedIn" via LinkedIn Developer App
# Maak een app op https://www.linkedin.com/developers/apps met producten
# "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn" (w_member_social)
# Redirect URI in de LinkedIn-app: https://ce.igisnext.com/api/account/linkedin/oauth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Mailbox / bron-credentials — AES-256-GCM (fallback: DB_PASS)
CE_CREDENTIAL_KEY=

# Eenmalige content-reset via POST /api/admin/reset-content (header X-CE-Reset-Token)
# Op productie eist dat endpoint daarnaast "confirmEnvironment": "production" in de body.
CE_RESET_TOKEN=

# Database-backups — bestemming buiten het cPanel-account (accountverlies/ransomware).
# Leeg = ../ce-db-backups naast dit project. Retentie: 14 dagelijks + 8 wekelijks.
#   ./scripts/backup-db.sh          (cron: 30 3 * * *)
#   ./scripts/restore-db.sh <file> local
CE_BACKUP_DIR=
