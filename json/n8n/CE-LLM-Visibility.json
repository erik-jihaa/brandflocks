    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key={{ $env.GOOGLE_GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
