      "parameters": {
        "jsCode": "\nconst input = $input.first()?.json || {};\nlet clientId = '';\nconst body = input.body && typeof input.body === 'object' ? input.body : input;\nif (body.clientId) clientId = String(body.clientId).trim();\nelse if (body.client_id) clientId = String(body.client_id).trim();\nreturn [{ json: { clientId } }];\n"
      },
      "id": "llmvis-prepare-scope",
      "name": "Prepare Scope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        420
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT q.id AS question_id, q.client_id, q.question, c.name AS client_name\nFROM llm_probleemvragen q\nJOIN clients c ON c.id = q.client_id\nWHERE q.active = 1 AND q.question_kind = 'geo'\n  AND ($1 = '' OR q.client_id = $1)\nORDER BY q.client_id, q.created_at",
        "options": {
          "queryReplacement": "={{ [ $('Prepare Scope').first().json.clientId || '' ] }}"
        }
      },
