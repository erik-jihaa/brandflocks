# Lokale restore-test — kopieer naar .env.local (gitignored).
# Docker: container ce_test_db, host-poort 3310.
#
#   docker compose up -d ce_test_db   # of bestaande container
#   CE_RESTORE_DOCKER=ce_test_db ./scripts/restore-db.sh ../ce-db-backups/daily/ce-production-*.sql.gz local
CE_ENV=local
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ce_restore_test
DB_USER=ce_test
DB_PASS=cetest
